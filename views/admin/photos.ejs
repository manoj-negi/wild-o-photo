<%- include("partials/head", { pageTitle: "Photos · Studio Admin" }) %>
<div class="flex min-h-screen flex-col">
  <%- include("partials/header", { flash: flash, primaryForm: "" }) %>

  <div class="grid flex-1 items-stretch" style="grid-template-columns: 214px 1fr">
    <%- include("partials/sidebar", { nav: nav, photos: photos, categories: categories }) %>

    <main class="min-w-0 px-7 pb-11 pt-6">
      <div class="mb-4 flex items-end justify-between gap-4">
        <div>
          <h1 class="m-0 mb-1 text-[21px] font-semibold tracking-tight">Photos</h1>
          <p class="m-0 text-[13px] text-mute">
            <span id="row-count"><%= photos.length %></span> of <%= photos.length %> photos ·
            <%= photos.filter(p => p.live).length %> live
          </p>
        </div>
        <div class="flex items-center gap-3">
          <span id="sort-state" class="text-xs text-mute">Sorted by date, descending</span>
          <a href="/admin/photos/new" class="pill-dark">Add photo</a>
        </div>
      </div>

      <div class="card overflow-hidden">
        <table class="w-full table-fixed border-collapse text-[13px]" data-table="photos">
          <thead>
            <tr class="bg-sand">
              <th class="th w-[74px]">Photo</th>
              <th class="th w-[17%]"><button type="button" class="sort flex w-full items-center gap-1 text-[11px] uppercase tracking-[0.1em]" data-key="cap">Caption <span class="text-amber"></span></button></th>
              <th class="th w-[12%]"><button type="button" class="sort flex w-full items-center gap-1 text-[11px] uppercase tracking-[0.1em]" data-key="slug">Slug <span class="text-amber"></span></button></th>
              <th class="th w-[11%]"><button type="button" class="sort flex w-full items-center gap-1 text-[11px] uppercase tracking-[0.1em]" data-key="category">Category <span class="text-amber"></span></button></th>
              <th class="th w-[14%]"><button type="button" class="sort flex w-full items-center gap-1 text-[11px] uppercase tracking-[0.1em]" data-key="collection">Collection <span class="text-amber"></span></button></th>
              <th class="th w-[12%]"><button type="button" class="sort flex w-full items-center gap-1 text-[11px] uppercase tracking-[0.1em]" data-key="camera">Camera <span class="text-amber"></span></button></th>
              <th class="th w-[10%]"><button type="button" class="sort flex w-full items-center gap-1 text-[11px] uppercase tracking-[0.1em]" data-key="date">Date <span class="text-amber"></span></button></th>
              <th class="th w-[9%]"><button type="button" class="sort flex w-full items-center gap-1 text-[11px] uppercase tracking-[0.1em]" data-key="live">Live <span class="text-amber"></span></button></th>
              <th class="th w-[122px] text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% photos.forEach(function (p) { %>
              <tr class="border-b border-[#f3ede4]"
                  data-cap="<%= p.cap %>" data-slug="<%= p.slug %>" data-category="<%= p.category %>"
                  data-collection="<%= p.collection %>" data-camera="<%= p.camera %>" data-date="<%= p.date %>"
                  data-live="<%= p.live ? 1 : 0 %>">
                <td class="td">
                  <div class="h-[34px] w-[46px] overflow-hidden rounded-[10px] bg-[#e6e0d7]">
                    <img src="<%= p.src %>" alt="<%= p.alt %>" class="block h-full w-full object-cover grayscale">
                  </div>
                </td>
                <td class="td truncate font-medium"><%= p.cap %></td>
                <td class="td truncate text-xs text-mute">/<%= p.slug %></td>
                <td class="td truncate text-xs"><%= p.category %></td>
                <td class="td truncate text-xs"><%= p.collection %></td>
                <td class="td truncate text-xs text-mute"><%= p.camera %></td>
                <td class="td whitespace-nowrap text-xs text-mute"><%= p.date %></td>
                <td class="td">
                  <form method="post" action="/admin/photos/<%= p.slug %>/toggle">
                    <button class="rounded-full px-3 py-1 text-[11px] uppercase tracking-wider <%= p.live ? 'border border-pine bg-pine text-cream' : 'border border-line2 bg-white text-mute' %>">
                      <%= p.live ? "Live" : "Draft" %>
                    </button>
                  </form>
                </td>
                <td class="td">
                  <div class="flex justify-end gap-1.5">
                    <a href="/admin/photos/<%= p.slug %>/edit" class="rounded-full border border-line2 bg-white px-3 py-1.5 text-xs hover:bg-sand">Edit</a>
                    <form method="post" action="/admin/photos/<%= p.slug %>/delete" data-confirm="Delete <%= p.cap %>?">
                      <button title="Delete" class="h-7 w-7 rounded-full border border-line2 bg-white text-sm leading-none text-mute hover:bg-sand">&times;</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>

        <div class="flex items-center justify-between gap-4 border-t border-[#eee7dd] bg-sand px-4 py-3 text-xs text-mute">
          <span id="footer-count"><%= photos.length %> of <%= photos.length %> photos</span>
          <div class="flex items-center gap-1.5">
            <button class="rounded-full border border-line2 bg-white px-3 py-1 text-xs text-[#a09a92]">Prev</button>
            <span class="px-1">Page 1 of 1</span>
            <button class="rounded-full border border-line2 bg-white px-3 py-1 text-xs text-[#a09a92]">Next</button>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
<%- include("partials/footer") %>
