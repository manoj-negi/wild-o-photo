<header class="flex items-center gap-6 whitespace-nowrap bg-pine px-6 py-3.5 text-cream">
  <a href="/admin/photos" class="flex flex-none items-center gap-3">
    <span class="grid h-[30px] w-[30px] place-items-center rounded-[10px] bg-amber text-sm font-bold text-pine">S</span>
    <span class="text-base font-semibold tracking-tight">Studio Admin</span>
  </a>

  <div class="flex min-w-0 flex-1 justify-center">
    <div class="relative w-full max-w-[460px]">
      <input id="admin-search" type="search" placeholder="Search photos, slugs, cameras, collections"
             class="w-full rounded-full border border-cream/20 bg-cream/10 py-2.5 pl-9 pr-4 text-[13px] text-cream placeholder:text-cream/45">
      <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-xs text-cream/50">&#8981;</span>
    </div>
  </div>

  <div class="flex flex-none items-center gap-3">
    <span id="save-state" class="text-xs text-cream/55"><%= typeof flash !== "undefined" && flash ? flash : "All changes saved" %></span>
    <button type="submit" form="<%= typeof primaryForm !== 'undefined' ? primaryForm : '' %>"
            class="rounded-full bg-amber px-4 py-2 text-xs font-semibold text-pine hover:bg-[#d79c4c]">Save changes</button>
  </div>
</header>
