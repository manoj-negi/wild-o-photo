<%
  const items = [
    { key: "photos",      label: "Photos",      href: "/admin/photos",     count: photos.length },
    { key: "add",         label: "Add photo",   href: "/admin/photos/new", count: "" },
    { key: "categories",  label: "Categories",  href: "/admin/categories", count: categories.length },
    { key: "collections", label: "Collections", href: "/admin/categories", count: "" },
    { key: "settings",    label: "Settings",    href: "/admin/photos",     count: "" }
  ];
%>
<nav class="flex flex-col gap-1 bg-pine2 p-5">
  <% items.forEach(function (it) { const on = nav === it.key; %>
    <a href="<%= it.href %>"
       class="flex w-full items-center justify-between gap-2 rounded-2xl px-3.5 py-2.5 text-[13px] <%= on ? 'bg-amber font-semibold text-pine' : 'text-cream/75 hover:bg-cream/5' %>">
      <span><%= it.label %></span>
      <span class="text-[11px] opacity-70"><%= it.count %></span>
    </a>
  <% }); %>
  <div class="mt-auto rounded-2xl bg-amber/15 px-3 py-3.5 text-xs leading-relaxed text-cream/70">
    <%= storage %> of 5 GB used
  </div>
</nav>
