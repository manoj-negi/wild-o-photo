<%# views/partials/footer.ejs — expects: cameras[] { brand, models[] { name, count } }, cameraOpen (bool) %>
  <nav class="fixed bottom-6 left-1/2 -translate-x-1/2 z-30">
    <div class="flex items-center gap-1 p-2 rounded-[26px] bg-paper dark:bg-nightpill shadow-[0_6px_28px_rgba(0,0,0,0.13)] dark:shadow-[0_6px_28px_rgba(0,0,0,0.6)]">
      <button type="button" data-filter="category" class="flex items-center gap-2 px-4 py-2.5 rounded-[18px] text-[15px] text-ink/75 dark:text-white/75 hover:bg-black/[0.04] dark:hover:bg-white/[0.07] transition-colors">
        <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><circle cx="17" cy="17" r="3"></circle><path d="m19.2 19.2 1.8 1.8"></path></svg><span>Category</span>
      </button>
      <button type="button" data-filter="collections" class="flex items-center gap-2 px-4 py-2.5 rounded-[18px] text-[15px] text-ink/75 dark:text-white/75 hover:bg-black/[0.04] dark:hover:bg-white/[0.07] transition-colors">
        <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="14" height="14" rx="2"></rect><path d="M7 8h6M20 7v10a2 2 0 0 1-2 2"></path></svg><span>Collections</span>
      </button>

      <div class="relative">
        <div id="cameraMenu" class="absolute bottom-[calc(100%+24px)] left-1/2 -translate-x-1/2 w-[218px] py-2 rounded-[14px] bg-[#f1f0ef] dark:bg-[#262626] shadow-[0_8px_30px_rgba(0,0,0,0.12)] dark:shadow-[0_8px_30px_rgba(0,0,0,0.6)]<%= cameraOpen ? '' : ' hidden' %>">
          <% cameras.forEach(function (group) { %>
            <p class="px-4 pt-2 pb-1 text-[11px] tracking-[0.06em] uppercase text-ink/40 dark:text-white/40"><%= group.brand %></p>
            <% group.models.forEach(function (m) { %>
              <button type="button" class="w-full flex items-center justify-between px-4 py-1.5 text-[15px] text-left hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-colors">
                <span><%= m.name %></span><span class="text-ink/35 dark:text-white/35">[<%= m.count %>]</span>
              </button>
            <% }); %>
          <% }); %>
        </div>
        <button type="button" id="cameraBtn" data-filter="camera" class="flex items-center gap-2 px-4 py-2.5 rounded-[18px] text-[15px] font-medium bg-black/[0.06] dark:bg-white/[0.12] transition-colors">
          <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5A2 2 0 0 1 5 6.5h2l1.2-2h7.6L17 6.5h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"></path><circle cx="12" cy="12.5" r="3.2"></circle></svg><span>Camera</span>
        </button>
      </div>

      <button type="button" data-filter="lens" class="flex items-center gap-2 px-4 py-2.5 rounded-[18px] text-[15px] text-ink/75 dark:text-white/75 hover:bg-black/[0.04] dark:hover:bg-white/[0.07] transition-colors">
        <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="3.4"></circle></svg><span>Lens</span>
      </button>
    </div>
  </nav>
  <script src="/js/app.js"></script>
</body>
</html>
