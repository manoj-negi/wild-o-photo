<%# views/partials/footer.ejs — all four menus populated via API %>
  <nav class="fixed bottom-4 sm:bottom-6 inset-x-0 z-30 flex justify-center px-4">
    <div class="relative">

      <%# ── Mobile / tablet trigger — the row below collapses into this panel below md ── %>
      <button type="button" id="filtersToggle" aria-expanded="false" aria-controls="filtersGroup" class="md:hidden flex items-center gap-2 px-5 py-3 rounded-[26px] bg-paper dark:bg-nightpill shadow-[0_6px_28px_rgba(0,0,0,0.13)] dark:shadow-[0_6px_28px_rgba(0,0,0,0.6)] text-[15px] text-ink/85 dark:text-white/85">
        <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M7 12h10M10 18h4"></path></svg><span>Filters</span>
      </button>

      <div id="filtersGroup" class="hidden w-[calc(100vw-2rem)] max-w-[300px] p-2 rounded-[20px] absolute bottom-[calc(100%+12px)] left-1/2 -translate-x-1/2
           md:flex md:flex-row md:items-center md:gap-1 md:static md:translate-x-0 md:w-auto md:max-w-none md:p-2 md:rounded-[26px]
           bg-paper dark:bg-nightpill shadow-[0_6px_28px_rgba(0,0,0,0.13)] dark:shadow-[0_6px_28px_rgba(0,0,0,0.6)]">

        <%# ── Category dropdown ──────────────────────────────────────── %>
        <div class="relative mb-1 md:mb-0">
          <div id="categoryMenu" class="absolute bottom-[calc(100%+8px)] md:bottom-[calc(100%+24px)] left-1/2 -translate-x-1/2 w-[min(218px,88vw)] py-2 rounded-[14px] bg-[#f1f0ef] dark:bg-[#262626] shadow-[0_8px_30px_rgba(0,0,0,0.12)] dark:shadow-[0_8px_30px_rgba(0,0,0,0.6)] hidden" aria-label="Category filter menu">
            <p class="px-4 py-2 text-[13px] text-ink/35 dark:text-white/35 italic menu-loading">Loading…</p>
          </div>
          <button type="button" id="categoryBtn" data-filter="category" class="w-full md:w-auto flex items-center gap-2 px-4 py-2.5 rounded-[18px] text-[15px] text-ink/75 dark:text-white/75 hover:bg-black/[0.04] dark:hover:bg-white/[0.07] transition-colors">
            <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><circle cx="17" cy="17" r="3"></circle><path d="m19.2 19.2 1.8 1.8"></path></svg><span>Category</span>
          </button>
        </div>

        <%# ── Collections dropdown ───────────────────────────────────── %>
        <div class="relative mb-1 md:mb-0">
          <div id="collectionsMenu" class="absolute bottom-[calc(100%+8px)] md:bottom-[calc(100%+24px)] left-1/2 -translate-x-1/2 w-[min(248px,88vw)] py-2 rounded-[14px] bg-[#f1f0ef] dark:bg-[#262626] shadow-[0_8px_30px_rgba(0,0,0,0.12)] dark:shadow-[0_8px_30px_rgba(0,0,0,0.6)] hidden" aria-label="Collections filter menu">
            <p class="px-4 py-2 text-[13px] text-ink/35 dark:text-white/35 italic menu-loading">Loading…</p>
          </div>
          <button type="button" id="collectionsBtn" data-filter="collections" class="w-full md:w-auto flex items-center gap-2 px-4 py-2.5 rounded-[18px] text-[15px] text-ink/75 dark:text-white/75 hover:bg-black/[0.04] dark:hover:bg-white/[0.07] transition-colors">
            <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="14" height="14" rx="2"></rect><path d="M7 8h6M20 7v10a2 2 0 0 1-2 2"></path></svg><span>Collections</span>
          </button>
        </div>

        <%# ── Location (Country) dropdown ─────────────────────────── %>
        <div class="relative mb-1 md:mb-0">
          <div id="countryMenu" class="absolute bottom-[calc(100%+8px)] md:bottom-[calc(100%+24px)] left-1/2 -translate-x-1/2 w-[min(320px,88vw)] py-2 rounded-[14px] bg-[#f1f0ef] dark:bg-[#262626] shadow-[0_8px_30px_rgba(0,0,0,0.12)] dark:shadow-[0_8px_30px_rgba(0,0,0,0.6)] hidden" aria-label="Location filter menu">
            <p class="px-4 py-2 text-[13px] text-ink/35 dark:text-white/35 italic menu-loading">Loading…</p>
          </div>
          <button type="button" id="countryBtn" data-filter="country" class="w-full md:w-auto flex items-center gap-2 px-4 py-2.5 rounded-[18px] text-[15px] text-ink/75 dark:text-white/75 hover:bg-black/[0.04] dark:hover:bg-white/[0.07] transition-colors">
            <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 3c2.7 2.5 2.7 13.5 0 18M3 12h18M4.2 7h15.6M4.2 17h15.6"></path></svg><span>Location</span>
          </button>
        </div>

        <%# ── Camera dropdown ────────────────────────────────────────── %>
        <div class="relative mb-1 md:mb-0">
          <div id="cameraMenu" class="absolute bottom-[calc(100%+8px)] md:bottom-[calc(100%+24px)] left-1/2 -translate-x-1/2 w-[min(218px,88vw)] py-2 rounded-[14px] bg-[#f1f0ef] dark:bg-[#262626] shadow-[0_8px_30px_rgba(0,0,0,0.12)] dark:shadow-[0_8px_30px_rgba(0,0,0,0.6)]<%= (typeof cameraOpen !== 'undefined' && cameraOpen) ? '' : ' hidden' %>" aria-label="Camera filter menu">
            <p class="px-4 py-2 text-[13px] text-ink/35 dark:text-white/35 italic menu-loading">Loading…</p>
          </div>
          <button type="button" id="cameraBtn" data-filter="camera" class="w-full md:w-auto flex items-center gap-2 px-4 py-2.5 rounded-[18px] text-[15px] text-ink/75 dark:text-white/75 hover:bg-black/[0.04] dark:hover:bg-white/[0.07] transition-colors">
            <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5A2 2 0 0 1 5 6.5h2l1.2-2h7.6L17 6.5h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"></path><circle cx="12" cy="12.5" r="3.2"></circle></svg><span>Camera</span>
          </button>
        </div>

        <%# ── Lens dropdown ──────────────────────────────────────────── %>
        <div class="relative mb-1 md:mb-0">
          <div id="lensMenu" class="absolute bottom-[calc(100%+8px)] md:bottom-[calc(100%+24px)] left-1/2 -translate-x-1/2 w-[min(248px,88vw)] py-2 rounded-[14px] bg-[#f1f0ef] dark:bg-[#262626] shadow-[0_8px_30px_rgba(0,0,0,0.12)] dark:shadow-[0_8px_30px_rgba(0,0,0,0.6)] hidden" aria-label="Lens filter menu">
            <p class="px-4 py-2 text-[13px] text-ink/35 dark:text-white/35 italic menu-loading">Loading…</p>
          </div>
          <button type="button" id="lensBtn" data-filter="lens" class="w-full md:w-auto flex items-center gap-2 px-4 py-2.5 rounded-[18px] text-[15px] text-ink/75 dark:text-white/75 hover:bg-black/[0.04] dark:hover:bg-white/[0.07] transition-colors">
            <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="3.4"></circle></svg><span>Lens</span>
          </button>
        </div>

        <%# ── Year dropdown ──────────────────────────────────────────── %>
        <div class="relative">
          <div id="yearMenu" class="absolute bottom-[calc(100%+8px)] md:bottom-[calc(100%+24px)] left-1/2 -translate-x-1/2 w-[min(218px,88vw)] py-2 rounded-[14px] bg-[#f1f0ef] dark:bg-[#262626] shadow-[0_8px_30px_rgba(0,0,0,0.12)] dark:shadow-[0_8px_30px_rgba(0,0,0,0.6)] hidden" aria-label="Year filter menu">
            <p class="px-4 py-2 text-[13px] text-ink/35 dark:text-white/35 italic menu-loading">Loading…</p>
          </div>
          <button type="button" id="yearBtn" data-filter="year" class="w-full md:w-auto flex items-center gap-2 px-4 py-2.5 rounded-[18px] text-[15px] text-ink/75 dark:text-white/75 hover:bg-black/[0.04] dark:hover:bg-white/[0.07] transition-colors">
            <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"></rect><path d="M3 9.5h18M8 3v3M16 3v3"></path></svg><span>Year</span>
          </button>
        </div>

        <%# ── Reset filters ──────────────────────────────────────────── %>
        <div class="relative">
          <button type="button" id="resetFiltersBtn" class="w-full md:w-auto flex items-center gap-2 px-4 py-2.5 rounded-[18px] text-[15px] text-ink/75 dark:text-white/75 hover:bg-black/[0.04] dark:hover:bg-white/[0.07] transition-colors">
            <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 1 3 6.7"></path><path d="M3 21v-6h6"></path></svg><span>Reset</span>
          </button>
        </div>

      </div>
    </div>
  </nav>
  <script src="/js/app.js"></script>
</body>
</html>
