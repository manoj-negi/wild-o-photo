<%# views/partials/header.ejs — expects: view ('flow' | 'grid') %>
  <header class="fixed top-0 left-0 right-0 z-30 h-[74px] bg-paper dark:bg-night">
    <div class="relative h-full px-4 sm:px-6 md:px-9 flex items-center">

      <button type="button" class="js-theme-toggle hidden md:flex items-center gap-2.5 text-[15px] text-ink/85 dark:text-white/85 hover:text-ink dark:hover:text-white transition-colors">
        <span class="w-[26px] h-[26px] rounded-[8px] border border-ink/25 dark:border-white/30 grid place-items-center text-[13px] leading-none font-medium">A</span>
        <span>Dark Mode</span>
      </button>

      <h1 class="absolute left-1/2 -translate-x-1/2 flex items-center justify-center h-full">
        <a href="/">
          <img src="/img/OfWild%26Walls.svg" alt="Of Wild &amp; Walls" class="h-[18px] md:h-[22px] w-auto dark:invert transition-transform hover:scale-105">
        </a>
      </h1>

      <div class="ml-auto hidden md:flex items-center gap-7">
        <a href="/" class="flex items-center gap-2.5 <%= view === 'flow' ? 'text-[15px] font-medium' : 'text-[15px] text-ink/40 dark:text-white/40 hover:text-ink/70 dark:hover:text-white/70 transition-colors' %>">
          <svg class="w-[19px] h-[19px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h14M5 21h14M8 3v2.4c0 2.6 4 4 4 6.6s-4 4-4 6.6V21M16 3v2.4c0 2.6-4 4-4 6.6s4 4 4 6.6V21"></path></svg><span>Flow</span>
        </a>
        <a href="/grid" class="flex items-center gap-2.5 <%= view === 'grid' ? 'text-[15px] font-medium' : 'text-[15px] text-ink/40 dark:text-white/40 hover:text-ink/70 dark:hover:text-white/70 transition-colors' %>">
          <svg class="w-[19px] h-[19px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M12 5v14"></path></svg><span>Grid</span>
        </a>
      </div>

      <%# ── Mobile / tablet hamburger — everything above collapses into this below md ── %>
      <button type="button" id="navToggle" aria-label="Menu" aria-expanded="false" aria-controls="navPanel" class="ml-auto md:hidden flex items-center justify-center w-9 h-9 -mr-1 rounded-[8px] text-ink/85 dark:text-white/85 hover:bg-black/[0.05] dark:hover:bg-white/[0.08] transition-colors">
        <svg id="navIconOpen" class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
        <svg id="navIconClose" class="w-[22px] h-[22px] hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>

    <%# ── Mobile / tablet nav panel — same Dark Mode / Flow / Grid controls, stacked ── %>
    <div id="navPanel" class="hidden md:hidden absolute top-full left-0 right-0 mx-4 mt-2 py-2 rounded-[14px] bg-[#f1f0ef] dark:bg-[#262626] shadow-[0_8px_30px_rgba(0,0,0,0.12)] dark:shadow-[0_8px_30px_rgba(0,0,0,0.6)]">
      <button type="button" class="js-theme-toggle w-full flex items-center gap-2.5 px-4 py-2.5 text-[15px] text-left text-ink/85 dark:text-white/85 hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-colors">
        <span class="w-[26px] h-[26px] rounded-[8px] border border-ink/25 dark:border-white/30 grid place-items-center text-[13px] leading-none font-medium">A</span>
        <span>Dark Mode</span>
      </button>
      <a href="/" class="flex items-center gap-2.5 px-4 py-2.5 text-[15px] <%= view === 'flow' ? 'font-medium text-ink dark:text-white' : 'text-ink/55 dark:text-white/55' %> hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-colors">
        <svg class="w-[19px] h-[19px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h14M5 21h14M8 3v2.4c0 2.6 4 4 4 6.6s-4 4-4 6.6V21M16 3v2.4c0 2.6-4 4-4 6.6s4 4 4 6.6V21"></path></svg><span>Flow</span>
      </a>
      <a href="/grid" class="flex items-center gap-2.5 px-4 py-2.5 text-[15px] <%= view === 'grid' ? 'font-medium text-ink dark:text-white' : 'text-ink/55 dark:text-white/55' %> hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-colors">
        <svg class="w-[19px] h-[19px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M12 5v14"></path></svg><span>Grid</span>
      </a>
    </div>
  </header>
