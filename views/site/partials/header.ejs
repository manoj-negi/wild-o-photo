<%# views/partials/header.ejs — expects: view ('flow' | 'grid') %>
  <header class="fixed top-0 left-0 right-0 z-30 h-[74px] bg-paper dark:bg-night">
    <div class="relative h-full px-6 md:px-9 flex items-center">

      <button type="button" id="themeToggle" class="flex items-center gap-2.5 text-[15px] text-ink/85 dark:text-white/85 hover:text-ink dark:hover:text-white transition-colors">
        <span class="w-[26px] h-[26px] rounded-[8px] border border-ink/25 dark:border-white/30 grid place-items-center text-[13px] leading-none font-medium">A</span>
        <span>Dark Mode</span>
      </button>

      <h1 class="absolute left-1/2 -translate-x-1/2 font-serif text-[27px] md:text-[31px] leading-none whitespace-nowrap">Of Wild &amp; Walls</h1>

      <div class="ml-auto flex items-center gap-7">
        <a href="/" class="flex items-center gap-2.5 <%= view === 'flow' ? 'text-[15px] font-medium' : 'text-[15px] text-ink/40 dark:text-white/40 hover:text-ink/70 dark:hover:text-white/70 transition-colors' %>">
          <svg class="w-[19px] h-[19px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h14M5 21h14M8 3v2.4c0 2.6 4 4 4 6.6s-4 4-4 6.6V21M16 3v2.4c0 2.6-4 4-4 6.6s4 4 4 6.6V21"></path></svg><span>Flow</span>
        </a>
        <a href="/grid" class="flex items-center gap-2.5 <%= view === 'grid' ? 'text-[15px] font-medium' : 'text-[15px] text-ink/40 dark:text-white/40 hover:text-ink/70 dark:hover:text-white/70 transition-colors' %>">
          <svg class="w-[19px] h-[19px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M12 5v14"></path></svg><span>Grid</span>
        </a>
      </div>
    </div>
  </header>
