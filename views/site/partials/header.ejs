<%# views/partials/header.ejs — expects: view ('flow' | 'grid'), the tab that
should render as initially active/visible on page load %>
<header class="fixed top-0 left-0 right-0 z-30 h-[74px] bg-paper dark:bg-night">
  <div class="relative h-full px-4 sm:px-6 md:px-9 flex items-center">
    <a
      href="https://www.instagram.com/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram"
      class="flex items-center justify-center text-ink/80 dark:text-white/80 hover:text-ink dark:hover:text-white transition-colors"
    >
      <svg
        class="w-[23px] h-[23px] text-ink/50 dark:text-white/50 -translate-y-[2px]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle
          cx="17.5"
          cy="6.5"
          r="0.8"
          fill="currentColor"
          stroke="none"
        ></circle>
      </svg>
    </a>

    <h1
      class="absolute left-1/2 -translate-x-1/2 flex items-center justify-center h-full"
    >
      <a href="/">
        <img
          src="/img/OfWild%26Walls.svg"
          alt="Of Wild &amp; Walls"
          class="h-[18px] md:h-[22px] w-auto dark:invert transition-transform hover:scale-105"
        />
      </a>
    </h1>

    <div class="ml-auto hidden md:flex items-center gap-7">
      <button
        type="button"
        class="js-theme-toggle hidden md:flex items-center justify-center text-ink/80 dark:text-white/80 hover:text-ink dark:hover:text-white transition-colors"
        aria-label="Toggle dark mode"
      >
        <!-- Moon — visible in light mode -->
        <svg
          class="theme-icon-moon w-[20px] h-[20px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
        >
          <path
            d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"
          ></path>
        </svg>

        <!-- Sun — visible in dark mode -->
        <svg
          class="theme-icon-sun hidden w-[20px] h-[20px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.42 1.42"></path>
          <path d="m17.65 17.65 1.42 1.42"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m4.93 19.07 1.42-1.42"></path>
          <path d="m17.65 6.35 1.42-1.42"></path>
        </svg>
      </button>

      <div class="h-5 w-px bg-ink/15 dark:bg-white/15"></div>

      <button
        type="button"
        data-nav-view="flow"
        class="nav-link-desktop flex items-center gap-2.5 <%= view === 'flow' ? 'text-[15px] font-medium' : 'text-[15px] text-ink/40 dark:text-white/40 hover:text-ink/70 dark:hover:text-white/70 transition-colors' %>"
      >
        <svg
          class="w-[19px] h-[19px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.71"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M7.2238 12.066C7.2238 8.21076 5.55236 5.47986 4.27929 3.80435C3.87536 3.27286 4.23232 2.51318 4.89975 2.51318H19.1007C19.7682 2.51318 20.1251 3.27286 19.7212 3.80435C18.448 5.47986 16.7767 8.21076 16.7767 12.066C16.7767 15.9213 18.448 18.6523 19.7212 20.3278C20.1251 20.8593 19.7682 21.6189 19.1007 21.6189H4.89975C4.23232 21.6189 3.87536 20.8593 4.27929 20.3278C5.55236 18.6523 7.2238 15.9213 7.2238 12.066Z"
          ></path></svg
        ><span>Flow</span>
      </button>
      <button
        type="button"
        data-nav-view="grid"
        class="nav-link-desktop flex items-center gap-2.5 <%= view === 'grid' ? 'text-[15px] font-medium' : 'text-[15px] text-ink/40 dark:text-white/40 hover:text-ink/70 dark:hover:text-white/70 transition-colors' %>"
      >
        <svg
          class="w-[19px] h-[19px]"
          viewBox="0 0 22 15"
          fill="none"
          stroke="currentColor"
          stroke-width="1.71"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M7.44971 13.055V1.50464" />
          <path d="M14.0454 1.50464V13.055" />
          <path
            d="M3.86343 13.6441C5.03915 13.3992 6.36311 13.1592 7.44981 13.0552C10.0135 12.8098 11.4809 12.8098 14.0446 13.0552C15.1313 13.1592 16.4553 13.3992 17.631 13.6441C19.1612 13.9629 20.6395 12.8152 20.6395 11.2522V3.30003C20.6395 1.73694 19.1612 0.589391 17.631 0.908138C16.4553 1.15303 15.1313 1.39307 14.0446 1.49706C11.4809 1.74234 10.0135 1.74234 7.44981 1.49706C6.36311 1.39307 5.03915 1.15303 3.86343 0.908138C2.33319 0.589391 0.854982 1.73694 0.854982 3.30003L0.85498 11.2522C0.85498 12.8152 2.33319 13.9629 3.86343 13.6441Z"
          /></svg
        ><span>Grid</span>
      </button>
    </div>

    <%# ── Mobile / tablet hamburger — everything above collapses into this
    below md ── %>
    <button
      type="button"
      id="navToggle"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="navPanel"
      class="ml-auto md:hidden flex items-center justify-center w-9 h-9 -mr-1 rounded-[8px] text-ink/85 dark:text-white/85 hover:bg-black/[0.05] dark:hover:bg-white/[0.08] transition-colors"
    >
      <svg
        id="navIconOpen"
        class="w-[22px] h-[22px]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
      >
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg
        id="navIconClose"
        class="w-[22px] h-[22px] hidden"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <%# ── Mobile / tablet nav panel — same Dark Mode / Flow / Grid controls,
  stacked ── %>
  <div
    id="navPanel"
    class="hidden md:hidden absolute top-full left-0 right-0 mx-4 mt-2 py-2 rounded-[14px] bg-[#f1f0ef] dark:bg-[#262626] shadow-[0_8px_30px_rgba(0,0,0,0.12)] dark:shadow-[0_8px_30px_rgba(0,0,0,0.6)]"
  >
    <button
      type="button"
      class="js-theme-toggle w-full flex items-center gap-2.5 px-4 py-2.5 text-[15px] text-left text-ink/85 dark:text-white/85 hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-colors"
      aria-label="Toggle dark mode"
    >
      <!-- Moon — visible in light mode -->
      <svg
        class="theme-icon-moon w-[19px] h-[19px]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
      >
        <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
      </svg>

      <!-- Sun — visible in dark mode -->
      <svg
        class="theme-icon-sun hidden w-[19px] h-[19px]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.42 1.42"></path>
        <path d="m17.65 17.65 1.42 1.42"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m4.93 19.07 1.42-1.42"></path>
        <path d="m17.65 6.35 1.42-1.42"></path>
      </svg>

      <span>Theme</span>
    </button>
    <button
      type="button"
      data-nav-view="flow"
      class="nav-link-mobile w-full flex items-center gap-2.5 px-4 py-2.5 text-[15px] text-left <%= view === 'flow' ? 'font-medium text-ink dark:text-white' : 'text-ink/55 dark:text-white/55' %> hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-colors"
    >
      <svg
        class="w-[19px] h-[19px]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M5 3h14M5 21h14M8 3v2.4c0 2.6 4 4 4 6.6s-4 4-4 6.6V21M16 3v2.4c0 2.6-4 4-4 6.6s4 4 4 6.6V21"
        ></path></svg
      ><span>Flow</span>
    </button>
    <button
      type="button"
      data-nav-view="grid"
      class="nav-link-mobile w-full flex items-center gap-2.5 px-4 py-2.5 text-[15px] text-left <%= view === 'grid' ? 'font-medium text-ink dark:text-white' : 'text-ink/55 dark:text-white/55' %> hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-colors"
    >
      <svg
        class="w-[19px] h-[19px]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="M12 5v14"></path></svg
      ><span>Grid</span>
    </button>
  </div>
</header>
