<%# views/index.ejs — flow view. expects: title, photos[] { src, alt, l, t, w, h } (vw units), cameras[] %>
<%- include('partials/head', { title: title }) %>
<%- include('partials/header', { view: 'flow' }) %>
<%
  /* True masonry, not a fixed repeating block: each column tracks its own current
     bottom edge, and every photo is dropped into whichever column is shortest right
     now. Columns then advance at their own pace instead of all waiting for the
     tallest one to finish before starting a "new row" — which is what produced a
     dead band across the idle columns every 10 photos. Each column alternates
     between its two tile heights (tall/short) as photos land in it. */
  var COLUMNS = [
    { l: 2,    w: 22, top: 2,   shapes: [29, 16] },
    { l: 26.5, w: 10, top: 1.4, shapes: [7,  20] },
    { l: 38.5, w: 22, top: 2,   shapes: [16, 21] },
    { l: 63.5, w: 10, top: 1.5, shapes: [13, 14] },
    { l: 76,   w: 22, top: 2,   shapes: [21, 21] },
  ];
  var COLUMN_GAP = 3;

  var columnBottoms = COLUMNS.map(function (c) { return c.top - COLUMN_GAP; });
  var columnCounts = COLUMNS.map(function () { return 0; });

  function nextAutoPos() {
    var idx = 0;
    for (var i = 1; i < columnBottoms.length; i++) {
      if (columnBottoms[i] < columnBottoms[idx]) idx = i;
    }
    var col = COLUMNS[idx];
    var t = columnBottoms[idx] + COLUMN_GAP;
    var h = col.shapes[columnCounts[idx] % col.shapes.length];
    columnCounts[idx]++;
    columnBottoms[idx] = t + h;
    return { l: col.l, t: t, w: col.w, h: h };
  }

  var positioned = photos.map(function (p) {
    var pos = nextAutoPos();
    return { photo: p, pos: pos };
  });
  var maxBottom = Math.max.apply(null, columnBottoms) + 4;
%>
<main class="pt-[74px]">
  <div id="flowCanvas" class="relative w-full"
       style="height:<%= maxBottom %>vw"
       data-offset="<%= typeof nextOffset !== 'undefined' ? nextOffset : photos.length %>"
       data-page-size="<%= typeof pageSize !== 'undefined' ? pageSize : photos.length %>"
       data-has-more="<%= typeof hasMore !== 'undefined' && hasMore ? '1' : '0' %>">
    <% positioned.forEach(function (item) {
      var p = item.photo, pos = item.pos;
    %>
      <a href="/photo/<%= p.slug %>" class="photo-item group absolute block"
         data-category="<%= p.category %>"
         data-collection="<%= p.collection %>"
         data-camera="<%= p.camera %>"
         data-lens="<%= p.lens %>"
         data-country="<%= p.country %>"
         data-state="<%= p.state %>"
         data-year="<%= p.year %>"
         style="left:<%= pos.l %>vw; top:<%= pos.t %>vw; width:<%= pos.w %>vw; height:<%= pos.h %>vw">
        <span class="block w-full h-full overflow-hidden">
          <img src="<%= p.src %>" alt="<%= p.alt %>" loading="lazy" class="w-full h-full object-cover select-none">
        </span>
        <span aria-hidden="true" class="pointer-events-none absolute inset-0 grid place-items-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          <span class="w-[68px] h-[68px] rounded-full border border-white/85 grid place-items-center shadow-[0_0_18px_rgba(0,0,0,0.35)]">
            <svg class="w-[26px] h-[26px] text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
          </span>
        </span>
        <span aria-hidden="true" class="pointer-events-none absolute -top-[12px] -left-[12px] w-[44px] h-[48px] border-t-2 border-l-2 border-[#c8a03c] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
        <span aria-hidden="true" class="pointer-events-none absolute -top-[12px] -right-[12px] w-[44px] h-[48px] border-t-2 border-r-2 border-[#c8a03c] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
        <span aria-hidden="true" class="pointer-events-none absolute -bottom-[12px] -left-[12px] w-[44px] h-[48px] border-b-2 border-l-2 border-[#c8a03c] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
        <span aria-hidden="true" class="pointer-events-none absolute -bottom-[12px] -right-[12px] w-[44px] h-[48px] border-b-2 border-r-2 border-[#c8a03c] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
        <span class="pointer-events-none absolute left-1/2 -translate-x-1/2 top-[calc(100%+18px)] whitespace-nowrap text-[15px] text-ink dark:text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300"><%= p.cap %></span>
      </a>
    <% }); %>
    <%# Carries each column's current bottom edge forward so app.js can keep stacking
        the next page's photos into the same 5 columns from exactly where this page
        left off, instead of restarting the masonry from scratch. %>
    <span id="flowState" hidden
          data-column-bottoms="<%= columnBottoms.join(',') %>"
          data-column-counts="<%= columnCounts.join(',') %>"></span>
    <%# Watched by app.js: crossing near this (moved to the new bottom edge after each
        page loads) triggers the next /api/photos/flow fetch. %>
    <div id="flowSentinel" class="absolute inset-x-0 pointer-events-none" style="top:<%= maxBottom %>vw; height:1px"></div>
  </div>
</main>
<script>window.__flowColumns = <%- JSON.stringify(COLUMNS) %>; window.__flowColumnGap = <%= COLUMN_GAP %>;</script>
<%- include('partials/footer', { cameras: cameras, cameraOpen: false }) %>
