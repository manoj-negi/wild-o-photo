<%# views/detail.ejs — expects: title, photo { src, alt, cap }, photos[] (the rail), details %>
  <%- include('partials/head', { title: title }) %>

    <%# ── Left thumbnail slider — organic staggered layout like reference ─── Hidden below md: it's a fixed 200px+ wide
      vertical strip that, combined with the top-right controls and the stage's own reserved padding, left no usable
      width for the actual photo/BACK button on a phone-size screen. %>
      <aside id="thumbRail"
        class="hidden md:flex fixed left-0 top-0 bottom-0 z-20 w-[14vw] min-w-[200px] max-w-[260px] flex-col justify-center select-none py-4 px-3">

        <%# Slider viewport %>
          <div id="railViewport" class="overflow-hidden w-full max-h-[92vh] flex flex-col py-1">
            <div id="railTrack" data-count="<%= photos.length %>"
              class="flex flex-col gap-[6px] transition-transform duration-500 ease-[cubic-bezier(.2,.7,.2,1)] py-1">
              <% var railLayout=[ [10, 80, 82], [10, 80, 82], [10, 80, 82], [10, 80, 82], [30, 80, 82], [48, 80, 82],
                [30, 80, 82], [10, 80, 82], [10, 80, 82] ]; var qs=(typeof filterQuery !=='undefined' && filterQuery)
                ? '?' + filterQuery : '' ; photos.forEach(function (p, i) { var lay=railLayout[i % railLayout.length];
                var dData=p.details || details || {}; %>
                <a href="/photo/<%= p.slug %><%= qs %>"
                  class="rail-thumb rail-in group block shrink-0 overflow-hidden transition-all duration-300 relative "
                  data-src="<%= p.src %>" data-alt="<%= p.alt %>" data-href="/photo/<%= p.slug %><%= qs %>"
                  data-title="<%= dData.title || p.title || '' %>" data-kicker="<%= dData.kicker || 'LANDSCAPE' %>"
                  data-ref="<%= dData.ref || 'REF: WILD-' + (i + 101) %>" data-about="<%= dData.about || '' %>"
                  data-altnote="<%= dData.altNote || '' %>" data-collection="<%= dData.collection || '' %>"
                  data-collectionhref="<%= dData.collectionHref || '#' %>"
                  data-camera="<%= dData.camera || 'SONY A7IV' %>"
                  data-lens="<%= dData.lens || 'FE 24-70MM F2.8 GM II' %>"
                  data-date="<%= dData.date || 'OCTOBER 2024' %>" data-location="<%= dData.location || 'GLOBAL' %>"
                  data-category="<%= dData.category || 'WILDLIFE' %>"
                  data-settings="<%= dData.settings || 'f/2.8 · 1/1000s · ISO 100' %>"
                  style="margin-left:<%= lay[0] %>px; width:<%= lay[1] %>px; height:<%= lay[2] %>px;">
                  <img src="<%= p.src %>" alt="<%= p.alt %>" loading="lazy" class="w-full h-full object-cover">
                </a>
                <% }); %>
            </div>
          </div>

      </aside>

      <%# ── Top-right controls ─────────────────────────────────────────── %>
        <div class="fixed top-4 right-4 md:top-6 md:right-8 z-30 flex items-center gap-2.5 sm:gap-3.5 md:gap-5">
         
          <button type="button" id="themeToggle" aria-label="Dark mode"
            class="js-theme-toggle text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 transition-colors">
            <svg class="w-[16px] h-[16px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
              stroke-linecap="round">
              <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
            </svg>
          </button>

          <button type="button" id="detailToggle" aria-label="Toggle details"
            class="w-8 h-8 rounded-full border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-800 dark:text-white flex items-center justify-center hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
            <svg id="detailPlus" class="w-[14px] h-[14px]" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round">
              <path d="M12 5v14M5 12h14"></path>
            </svg>
            <svg id="detailClose" class="w-[14px] h-[14px] hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round">
              <path d="M18 6L6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <%# ── Main stage — photo fills center, right padding adjusts when drawer opens. Side padding matches the
          thumbnail rail/details panel widths only at md+, where those are actually visible; below that both are
          full-screen overlays instead, so the stage just needs a small side gutter. ── %>
          <main id="stage"
            class="h-screen flex flex-col items-center justify-center pt-20 pb-4 px-4 md:pl-[180px] md:pr-[120px] transition-all duration-500 ease-out">
            <div class="flex-1 flex items-center justify-center w-full min-h-0">
              <img id="mainPhoto" src="<%= photo.src %>" alt="<%= photo.alt %>"
                class="fade-up max-h-full w-auto max-w-full object-contain block cursor-zoom-in">
            </div>
            <a href="/" id="photoBackBtn"
              class="shrink-0 py-3 text-[18px] font-black tracking-[0.04em] uppercase flex items-center justify-center gap-2 hover:opacity-60 transition-opacity">&larr;&nbsp;
              BACK</a>
          </main>

          <%# ── Full-width zoom overlay — click the main photo to expand it with a left/right gutter;
            click again (or the backdrop, or Esc) to shrink it back. ── %>
            <div id="photoZoomOverlay"
              class="fixed inset-0 z-40 hidden items-center justify-center bg-black/95 px-4 sm:px-10 md:px-20 py-8" style="cursor: none;">
              <img id="photoZoomImg" src="" alt="" class="max-h-full max-w-full w-auto h-auto object-contain">
              
              <%# ── Custom close cursor that follows mouse ── %>
              <div id="zoomCursor" class="pointer-events-none fixed z-50 flex items-center justify-center w-[54px] h-[54px] border border-black/10 bg-white/30 backdrop-blur-md rounded-sm shadow-sm transition-opacity duration-200 opacity-0 -translate-x-1/2 -translate-y-1/2" style="left: -100px; top: -100px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="1.5" stroke-linecap="round">
                  <path d="M18 6L6 18M6 6l12 12"/>
                </svg>
                <span class="absolute top-[6px] left-[6px] w-[8px] h-[8px] border-t-2 border-l-2 border-black/80"></span>
                <span class="absolute top-[6px] right-[6px] w-[8px] h-[8px] border-t-2 border-r-2 border-black/80"></span>
                <span class="absolute bottom-[6px] left-[6px] w-[8px] h-[8px] border-b-2 border-l-2 border-black/80"></span>
                <span class="absolute bottom-[6px] right-[6px] w-[8px] h-[8px] border-b-2 border-r-2 border-black/80"></span>
              </div>
            </div>

          <%# ── Details side-panel (Hidden by default until '+' clicked) ───────────────────────── %>
            <% var d=details; %>
              <aside id="detailsPanel"
                class="fixed right-0 top-20 bottom-0 z-20 w-[min(360px,92vw)] bg-white dark:bg-[#121212] border-t border-l border-neutral-200 dark:border-neutral-800 overflow-y-auto no-bar pt-8 px-6 md:px-8 pb-12 text-neutral-800 dark:text-neutral-200 transition-transform duration-300 ease-in-out translate-x-full">
                <div>
                  <p data-field="kicker" class="text-[10px] font-semibold tracking-[0.18em] uppercase text-neutral-400">
                    <%= d.kicker || 'LANDSCAPE' %>
                  </p>
                  <h2 data-field="title"
                    class="mt-2 font-serif italic text-[25px] leading-tight text-neutral-900 dark:text-white">
                    <%= d.title %>
                  </h2>
                  <p data-field="ref" class="mt-1 font-mono text-[11px] tracking-[0.08em] text-neutral-400">
                    <%= d.ref %>
                  </p>

                  <div class="my-6 border-t border-dashed border-neutral-200 dark:border-neutral-800"></div>
                  <p
                    class="text-[10px] font-bold tracking-[0.14em] uppercase text-neutral-400 flex items-center gap-1.5">
                    <span class="w-[4px] h-[4px] rounded-full bg-amber-500"></span> ABOUT THE PHOTO
                  </p>
                  <p data-field="about"
                    class="mt-2.5 text-[13px] leading-[1.6] font-normal text-neutral-700 dark:text-neutral-300">
                    <%= d.about %>
                  </p>
                  <p class="mt-4 text-[10px] font-bold tracking-[0.14em] uppercase text-neutral-400">ALTERNATE NOTE</p>
                  <p data-field="altNote"
                    class="mt-1.5 text-[13px] leading-[1.6] text-neutral-500 dark:text-neutral-400">
                    <%= d.altNote %>
                  </p>

                  <div class="my-6 border-t border-dashed border-neutral-200 dark:border-neutral-800"></div>
                  <p
                    class="text-[10px] font-bold tracking-[0.14em] uppercase text-neutral-400 flex items-center gap-1.5">
                    <span class="w-[4px] h-[4px] rounded-full bg-amber-500"></span> ABOUT THE COLLECTION
                  </p>
                  <p data-field="collection"
                    class="mt-2.5 text-[13px] leading-[1.6] text-neutral-700 dark:text-neutral-300">
                    <%= d.collection %>
                  </p>
                  <a href="<%= d.collectionHref %>"
                    class="mt-3 inline-block font-mono text-[10px] font-bold tracking-[0.12em] uppercase text-amber-600 dark:text-amber-400 hover:underline">VIEW
                    FULL COLLECTION &rarr;</a>

                  <div class="my-6 border-t border-dashed border-neutral-200 dark:border-neutral-800"></div>
                  <p
                    class="text-[10px] font-bold tracking-[0.14em] uppercase text-neutral-400 flex items-center gap-1.5">
                    <span class="w-[4px] h-[4px] rounded-full bg-amber-500"></span> CAMERA
                  </p>
                  <p data-field="camera" class="mt-2 text-[13px] font-medium text-neutral-800 dark:text-neutral-200">
                    <%= d.camera %> / <span class="text-amber-600 dark:text-amber-400">
                        <%= d.lens %>
                      </span>
                  </p>

                  <div class="my-6 border-t border-dashed border-neutral-200 dark:border-neutral-800"></div>
                  <p
                    class="text-[10px] font-bold tracking-[0.14em] uppercase text-neutral-400 flex items-center gap-1.5">
                    <span class="w-[4px] h-[4px] rounded-full bg-amber-500"></span> FIELD DATA
                  </p>
                  <div class="mt-3 grid grid-cols-2 gap-y-4 gap-x-4">
                    <div>
                      <p class="text-[10px] font-bold tracking-[0.12em] uppercase text-neutral-400">DATE</p>
                      <p data-field="date" class="mt-1 text-[12px] font-medium text-neutral-800 dark:text-neutral-200">
                        <%= d.date %>
                      </p>
                    </div>
                    <div>
                      <p class="text-[10px] font-bold tracking-[0.12em] uppercase text-neutral-400">LOCATION</p>
                      <p data-field="location"
                        class="mt-1 text-[12px] font-medium text-neutral-800 dark:text-neutral-200">
                        <%= d.location %>
                      </p>
                    </div>
                    <div>
                      <p class="text-[10px] font-bold tracking-[0.12em] uppercase text-neutral-400">CATEGORY</p>
                      <p data-field="category"
                        class="mt-1 text-[12px] font-medium text-neutral-800 dark:text-neutral-200">
                        <%= d.category %>
                      </p>
                    </div>
                    <div>
                      <p class="text-[10px] font-bold tracking-[0.12em] uppercase text-neutral-400">SETTINGS</p>
                      <p data-field="settings"
                        class="mt-1 text-[12px] font-medium text-neutral-800 dark:text-neutral-200">
                        <%= d.settings %>
                      </p>
                    </div>
                  </div>
                </div>
              </aside>

              <script src="/js/app.js"></script>
              </body>

              </html>